{
  "name": "agent-trajectory-marketplace",
  "version": "2026.08.30.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "Bun CLI for collecting and publishing credential-redacted agent trajectories",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/effortprogrammer/agent-trajectory-marketplace.git"
  },
  "homepage": "https://github.com/effortprogrammer/agent-trajectory-marketplace",
  "bugs": {
    "url": "https://github.com/effortprogrammer/agent-trajectory-marketplace/issues"
  },
  "keywords": [
    "agent-trajectories",
    "collector",
    "atf"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "atm-collector": "dist/collector.js",
    "trajectory": "dist/collector.js"
  },
  "scripts": {
    "build": "bun run build:collector",
    "build:collector": "bun build src/cli/index.ts --outfile dist/collector.js --target bun",
    "precollector": "bun run build:collector",
    "collector": "bun dist/collector.js",
    "pretrajectory": "bun run build:collector",
    "trajectory": "bun dist/collector.js",
    "typecheck": "bunx tsc --noEmit",
    "verify:publish-wire": "bun contract/publish-wire/v1/generate.ts --check contract/publish-wire/v1 && bun contract/publish-wire/v1/verify.ts --manifest contract/publish-wire/v1/manifest.json",
    "test": "bun test test/bun",
    "test:e2e:registry": "bun test test/bun/e2e/world-marketplace-flow.test.ts",
    "check": "bun run typecheck && bun run verify:publish-wire && bun run verify:wallet-balance && bun run verify:payout-request && bun run verify:seller-sales && bun run verify:upload-list && bun test test/bun && bun run build:collector && bash test/promotion-workflow.test.sh",
    "verify:wallet-balance": "bun contract/wallet-balance/v1/verify.ts --manifest contract/wallet-balance/v1/manifest.json",
    "verify:payout-request": "bun contract/payout-request/v1/verify.ts --manifest contract/payout-request/v1/manifest.json",
    "verify:seller-sales": "bun contract/seller-sales/v1/verify.ts",
    "verify:upload-list": "bun contract/upload-list/v1/verify.ts"
  },
  "dependencies": {
    "ky": "^2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "playwright": "^1.62.1",
    "typescript": "^5",
    "wrangler": "4.58.0"
  }
}
