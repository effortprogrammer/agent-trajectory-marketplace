{
  "name": "agent-trajectory-marketplace",
  "version": "1.0.2",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "Bun CLI for collecting and publishing credential-redacted agent trajectories",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/effortprogrammer/agent-trajectory-marketplace.git"
  },
  "homepage": "https://github.com/effortprogrammer/agent-trajectory-marketplace",
  "bugs": {
    "url": "https://github.com/effortprogrammer/agent-trajectory-marketplace/issues"
  },
  "keywords": [
    "agent-trajectories",
    "collector",
    "atf"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "atm-collector": "dist/collector.js",
    "trajectory": "dist/collector.js"
  },
  "scripts": {
    "build": "bun run build:collector",
    "build:collector": "bun build src/cli/index.ts --outfile dist/collector.js --target bun",
    "precollector": "bun run build:collector",
    "collector": "bun dist/collector.js",
    "pretrajectory": "bun run build:collector",
    "trajectory": "bun dist/collector.js",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test test/bun",
    "check": "bun run typecheck && bun test test/bun && bun run build:collector"
  },
  "dependencies": {
    "ky": "^2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5"
  }
}
