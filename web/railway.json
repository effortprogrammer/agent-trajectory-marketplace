{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "bun install && bun run build"
  },
  "deploy": {
    "startCommand": "bunx wrangler dev --ip 0.0.0.0 --port ${PORT:-8080}",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120
  }
}
